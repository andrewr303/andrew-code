# fusion/config/defaults.env
# Optional Fusion panel config. Sourced by the provider adapters at dispatch.
# Everything here is COMMENTED OUT — the adapters ship with these exact values
# baked in as defaults. Uncomment a line to override without exporting env vars.
#
# EASIEST way to change models: Claude Code plugin config —
#   /plugin  →  configure  →  fusion        (interactive)
#   claude plugin install fusion@fusion-marketplace --config codex_effort=high ...
# Precedence: explicit FUSION_* env  >  this file  >  plugin config  >  baked default.

# ---- models -----------------------------------------------------------------
export FUSION_CODEX_MODEL="${FUSION_CODEX_MODEL:-gpt-5.6-sol}"   # Chief Operator model
export FUSION_CODEX_EFFORT="${FUSION_CODEX_EFFORT:-xhigh}"       # Chief Operator reasoning effort
export FUSION_FABLE_MODEL="${FUSION_FABLE_MODEL:-fable-5.1}"     # Main Planner / CEO model
export FUSION_FABLE_EFFORT="${FUSION_FABLE_EFFORT:-xhigh}"       # Main Planner reasoning effort
export FUSION_ANDREWCODE_MODEL="${FUSION_ANDREWCODE_MODEL:-meta/muse-spark-1.3-contributor}" # Worker model
export FUSION_ANDREWCODE_EFFORT="${FUSION_ANDREWCODE_EFFORT:-xhigh}" # Worker reasoning effort
export FUSION_COPILOT_MODEL="gpt-5.6-sol"
export FUSION_KIMI_MODEL="${FUSION_KIMI_MODEL:-azure/kimi-k3}"   # co-leader seat (Moonshot family - independent vote vs gpt/gemini)
export FUSION_OPENCODE_MODEL="${FUSION_OPENCODE_MODEL:-meta/muse-spark-1.2-contributor}"
export FUSION_GROK_MODEL="${FUSION_GROK_MODEL:-grok-4.5}"      # expert A model (was: grok-build default)

# ---- reasoning effort -------------------------------------------------------
export FUSION_OPENCODE_VARIANT="${FUSION_OPENCODE_VARIANT:-xhigh}"  # opencode --variant (reasoning effort)
# export FUSION_GROK_EFFORT=""           # grok-build does NOT accept effort (verified: HTTP 400). Leave empty.

# ---- sandbox ----------------------------------------------------------------
# export FUSION_CODEX_SANDBOX="workspace-write"   # read-only | workspace-write | danger-full-access

# ---- wall-clock timeouts (seconds) ------------------------------------------
# export FUSION_CODEX_TIMEOUT="900"      # codex xhigh can take minutes
# export FUSION_COPILOT_TIMEOUT="600"
# export FUSION_OPENCODE_TIMEOUT="600"
# export FUSION_GROK_TIMEOUT="600"

# ============================================================================
# MetaLoop (fusion:metaloop) — Board Advisor(CEO) + Chief Operator + tiered swarm.
# All commented out; these are the baked-in Phase-1 defaults. Uncomment to override.
#
# Org chart: Fable 5 is the CEO — it frames EVERY run first (advisor_policy=always).
# Codex (gpt-5.6-sol @ xhigh) is the Chief Operator — DISPATCHED at plan /
# adjudicate / integration-review points when the host is not Codex. Experts = Grok 4.5 + GLM/
# OpenCode. Fast tier = TWO Antigravity (agy) sessions on Gemini 3.5 Flash (one
# gemini family — throughput, not two votes). Copilot is NOT a MetaLoop worker.
# ============================================================================
# ---- MetaLoop models --------------------------------------------------------
export FUSION_FABLE_MODEL="${FUSION_FABLE_MODEL:-fable-5.1}"         # Main Planner / CEO (Claude Code print mode)
export FUSION_FABLE_EFFORT="${FUSION_FABLE_EFFORT:-xhigh}"           # Main Planner reasoning effort
export FUSION_CODEX_MODEL="${FUSION_CODEX_MODEL:-gpt-5.6-sol}"       # Chief Operator (Codex orchestrator)
export FUSION_CODEX_EFFORT="${FUSION_CODEX_EFFORT:-xhigh}"           # Chief Operator reasoning effort
export FUSION_METALOOP_WORKER_PROVIDER="${FUSION_METALOOP_WORKER_PROVIDER:-andrewcode}" # Worker provider
export FUSION_METALOOP_WORKER_MODEL="${FUSION_METALOOP_WORKER_MODEL:-meta/muse-spark-1.3-contributor}" # Worker model
export FUSION_METALOOP_WORKER_EFFORT="${FUSION_METALOOP_WORKER_EFFORT:-xhigh}" # Worker reasoning effort
export FUSION_AGY_MODEL="gemini-3.6-flash-high"                      # fast tier alternative
export FUSION_GROK_MODEL="${FUSION_GROK_MODEL:-grok-4.5}"             # expert A (Grok 4.5)
export FUSION_OPENCODE_MODEL="${FUSION_OPENCODE_MODEL:-meta/muse-spark-1.2-contributor}" # expert B (Muse Spark 1.2 Contributor)

# ---- MetaLoop advisor / worker effort / timeouts ----------------------------
export FUSION_FABLE_EFFORT="xhigh"
export FUSION_CODEX_EFFORT="xhigh"
export FUSION_ANDREWCODE_EFFORT="xhigh"
# export FUSION_FABLE_TIMEOUT="900"
# export FUSION_AGY_TIMEOUT="600"

# ---- MetaLoop policy + budgets ----------------------------------------------
# export FUSION_META_ADVISOR_POLICY="always" # off | on-demand | auto | always (default: always — Fable is the CEO and frames every run first)
# export FUSION_META_MAX_ADVISOR_CALLS="2"   # hard cap on Fable consults per run (CEO preflight + optional final)
# export FUSION_META_MAX_REPAIR_ROUNDS="2"
# export FUSION_META_MAX_ATTEMPTS_PER_TASK="3"
# export FUSION_META_EXPERT_CONCURRENCY="2"
# export FUSION_META_FAST_CONCURRENCY="2"    # two concurrent agy fast sessions
# export FUSION_META_MAX_CALLS="12"          # max total external worker+advisor calls
# export FUSION_META_MAX_WALL_SECONDS="1800"
# export FUSION_META_WORKSPACE_MODE="proposal"   # proposal (v1) | worktree (Phase 2)

# ---- MetaLoop worker repo snapshot (proposal-mode real-repo READ) -----------
# A worker is given a disposable COPY of the repo so it can read the codebase
# without ever writing the user's tree. Tune the copy caps if repos are large.
# export FUSION_WORKER_REPO=""               # repo dir a worker snapshots (usually set per-dispatch)
# export FUSION_SNAPSHOT_MAX_FILES="4000"    # cap on files copied into a worker snapshot
# export FUSION_SNAPSHOT_MAX_FILE_KB="512"   # per-file size cap (KB) for the snapshot
# export FUSION_PROMPT_INLINE_MAX="16000"    # prompts larger than this become work/.fusion-task.md

# ---- MetaLoop Chief Operator (codex, dispatched) -----------------------------
export FUSION_META_OPERATOR_POLICY="${FUSION_META_OPERATOR_POLICY:-always}"   # off | always — dispatch codex at plan/adjudicate/review points
export FUSION_META_MAX_OPERATOR_CALLS="${FUSION_META_MAX_OPERATOR_CALLS:-3}"     # plan + adjudicate + integration review

# ============================================================================
# Nested Hive (fusion:hive) — architect + captains + andrewcode workers.
# Nested workers are ALWAYS real AndrewCode processes
#   andrewcode -p ... -m <model> --auto -y --output-format text
# even when a captain is opencode / glm / grok / copilot / kimi.
# Hive identity rides FUSION_BOARD + FUSION_AGENT_ID (never stripped).
# ============================================================================
export FUSION_HIVE_MAX_DEPTH="${FUSION_HIVE_MAX_DEPTH:-2}"
export FUSION_HIVE_MAX_CHILDREN="${FUSION_HIVE_MAX_CHILDREN:-4}"
export FUSION_HIVE_MAX_AGENTS="${FUSION_HIVE_MAX_AGENTS:-24}"
export FUSION_ANDREWCODE_AUTO="${FUSION_ANDREWCODE_AUTO:-1}"   # 1 → pass --auto -y to nested andrewcode workers
export FUSION_ARCHITECT_PROVIDER="${FUSION_ARCHITECT_PROVIDER:-fable}"
export FUSION_ARCHITECT_MODEL="${FUSION_ARCHITECT_MODEL:-fable-5.1}"
export FUSION_ASTRA_MODEL="${FUSION_ASTRA_MODEL:-gpt-6-astra}"

# ============================================================================
# PER-MODE OVERRIDES (managed via /fusion:dashboard -> Swarm Modes tab)
# Each /fusion:<mode> can override a provider model/effort INDEPENDENTLY of the
# global keys above. Keyed on the engine pattern the CLI dispatches, so the key
# the dashboard writes is exactly the key the engine reads (adapter.resolve_*).
# Precedence: explicit env > per-mode key (below, if uncommented + non-empty) >
# global FUSION_<PROVIDER>_* > baked default. Empty/commented = no override.
# Only providers a mode ACTUALLY dispatches get a key; EFFORT only where the
# adapter consumes it (not grok: rejects effort; not agy: effort is in the model
# name). metaloop is host-skill-orchestrated and intentionally has no keys here.
# ============================================================================
# ---- /fusion:ballot --------------------------------------------------------
# export FUSION_BALLOT_CODEX_MODEL=""
# export FUSION_BALLOT_CODEX_EFFORT=""
# export FUSION_BALLOT_COPILOT_MODEL=""
# export FUSION_BALLOT_COPILOT_EFFORT=""
# export FUSION_BALLOT_OPENCODE_MODEL=""
# export FUSION_BALLOT_OPENCODE_EFFORT=""
# export FUSION_BALLOT_GROK_MODEL=""
# ---- /fusion:bestof --------------------------------------------------------
# export FUSION_BESTOF_CODEX_MODEL=""
# export FUSION_BESTOF_CODEX_EFFORT=""
# ---- /fusion:breaker -------------------------------------------------------
# export FUSION_BREAKER_CODEX_MODEL=""
# export FUSION_BREAKER_CODEX_EFFORT=""
# export FUSION_BREAKER_GROK_MODEL=""
# ---- /fusion:discuss -------------------------------------------------------
# export FUSION_DISCUSS_CODEX_MODEL=""
# export FUSION_DISCUSS_CODEX_EFFORT=""
# export FUSION_DISCUSS_COPILOT_MODEL=""
# export FUSION_DISCUSS_COPILOT_EFFORT=""
# export FUSION_DISCUSS_OPENCODE_MODEL=""
# export FUSION_DISCUSS_OPENCODE_EFFORT=""
# export FUSION_DISCUSS_GROK_MODEL=""
# ---- /fusion:flow ----------------------------------------------------------
# export FUSION_FLOW_CODEX_MODEL=""
# export FUSION_FLOW_CODEX_EFFORT=""
# export FUSION_FLOW_COPILOT_MODEL=""
# export FUSION_FLOW_COPILOT_EFFORT=""
# export FUSION_FLOW_OPENCODE_MODEL=""
# export FUSION_FLOW_OPENCODE_EFFORT=""
# export FUSION_FLOW_GROK_MODEL=""
# ---- /fusion:graph ---------------------------------------------------------
# DEFAULT ROSTER (set 2026-07-31 by user instruction). /fusion:graph runs as:
#   claude (in-context host)      = LEADER    - backend work; owns the merge and
#                                               judges every panelist output.
#   kimi   azure/kimi-k3          = CO-LEADER - frontend work + integration review.
#   agy    Gemini 3.5 Flash (High)= WORKERS   - bounded, parallel, mechanical jobs.
# codex is NOT in the default graph roster: at max/xhigh effort it repeatedly
# exceeded the harness wall-clock, and >2 concurrent codex processes triggered
# STATUS_DLL_INIT_FAILED, silently degrading it to slow web fetches. Set the
# codex keys below explicitly if a run genuinely needs it.
# grok is excluded per standing user instruction (2026-07-21): no grok as worker.
export FUSION_GRAPH_KIMI_MODEL="${FUSION_GRAPH_KIMI_MODEL:-azure/kimi-k3}"
export FUSION_GRAPH_AGY_MODEL="${FUSION_GRAPH_AGY_MODEL:-Gemini 3.5 Flash (High)}"
# export FUSION_GRAPH_CODEX_MODEL=""
# export FUSION_GRAPH_CODEX_EFFORT=""
# export FUSION_GRAPH_COPILOT_MODEL=""
# export FUSION_GRAPH_COPILOT_EFFORT=""
# export FUSION_GRAPH_OPENCODE_MODEL=""
# export FUSION_GRAPH_OPENCODE_EFFORT=""
# export FUSION_GRAPH_GROK_MODEL=""
