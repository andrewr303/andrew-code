{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fusion MetaLoop Contracts",
  "type": "object",
  "required": ["taskSpec", "workerResult", "advisorMemo", "gateResult"],
  "properties": {
    "taskSpec": {
      "type": "object",
      "required": [
        "id", "objective", "category", "complexity", "risk", "dependencies",
        "allowed_paths", "acceptance_criteria", "preferred_tier", "fallback_chain",
        "artifact_contract", "approval_level"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "complexity": {"type": "integer", "minimum": 0, "maximum": 3},
        "risk": {"type": "integer", "minimum": 0, "maximum": 3},
        "novelty": {"type": "integer", "minimum": 0, "maximum": 3},
        "ambiguity": {"type": "integer", "minimum": 0, "maximum": 3},
        "latency_priority": {"type": "integer", "minimum": 0, "maximum": 3},
        "context_size": {"type": "integer", "minimum": 0, "maximum": 3},
        "blast_radius": {"type": "integer", "minimum": 0, "maximum": 3},
        "tool_needs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "allowed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbidden_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "verification_cmd": {"type": ["string", "null"]},
        "preferred_tier": {"enum": ["host", "advisor", "expert", "fast"]},
        "preferred_provider": {"type": ["string", "null"]},
        "fallback_chain": {"type": "array", "items": {"type": "string"}},
        "artifact_contract": {"type": "object"},
        "approval_level": {"enum": ["none", "human_before_execute", "human_before_integrate"]}
      },
      "additionalProperties": false
    },
    "workerResult": {
      "type": "object",
      "required": [
        "task_id", "provider", "model", "model_family", "harness", "attempt",
        "status", "summary", "artifacts", "evidence", "checks_run", "confidence",
        "blockers", "scope_expansion_needed"
      ],
      "properties": {
        "task_id": {"type": "string"},
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "model_family": {"type": "string"},
        "harness": {"type": "string"},
        "attempt": {"type": "integer", "minimum": 1},
        "status": {"enum": ["returned", "absent", "timeout", "error", "blocked", "fallback"]},
        "summary": {"type": "string"},
        "artifacts": {"type": "array", "items": {"type": "object"}},
        "patch": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "checks_run": {"type": "array", "items": {"type": "object"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "scope_expansion_needed": {"type": "boolean"},
        "notes_for_integrator": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "advisorMemo": {
      "type": "object",
      "required": [
        "decision", "plan_version", "consult_reason", "risk_findings",
        "decomposition_findings", "missing_evidence", "required_changes",
        "optional_taste_notes", "confidence"
      ],
      "properties": {
        "decision": {"enum": ["approve", "revise", "stop"]},
        "plan_version": {"type": "integer", "minimum": 1},
        "consult_reason": {"type": "string"},
        "risk_findings": {"type": "array", "items": {"type": "object"}},
        "decomposition_findings": {"type": "array", "items": {"type": "string"}},
        "missing_evidence": {"type": "array", "items": {"type": "string"}},
        "required_changes": {"type": "array", "items": {"type": "string"}},
        "optional_taste_notes": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "gateResult": {
      "type": "object",
      "required": ["gate_id", "run_id", "status", "commands", "acceptance_checks", "violations"],
      "properties": {
        "gate_id": {"type": "string"},
        "run_id": {"type": "string"},
        "status": {"enum": ["pass", "fail", "blocked", "skipped"]},
        "commands": {"type": "array", "items": {"type": "object"}},
        "acceptance_checks": {"type": "array", "items": {"type": "object"}},
        "changed_paths": {"type": "array", "items": {"type": "string"}},
        "violations": {"type": "array", "items": {"type": "string"}},
        "verified_at": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
